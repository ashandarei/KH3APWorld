{
  "schema": "kh3ap.poptracker.music_chests.v1",
  "game": "Kingdom Hearts III",
  "introduced_in": "0.14",
  "options": {
    "music_chest_count": {
      "min": 0,
      "max": 8,
      "behavior": "Select this many distinct authored placements and assign unique randomized songs."
    },
    "music_chest_vanilla_conversion": {
      "min": 0,
      "max": 128,
      "behavior": "Convert existing vanilla chests; preserve their location IDs. Both options share the 128-song pool."
    }
  },
  "tracking": {
    "active_locations": "slot_data.bridge.locations: music_chest_placement_version == 1",
    "identity": "Match ap_location_id; the song is randomized per seed and is not the location identity.",
    "completion": "Track Archipelago checked_locations. A song clear alone is not a location check; KH3 opens the chest and persists AP_LBOX_### in RandomizerChests.sav.",
    "song_fields": [
      "mom_song_id",
      "mom_song_name",
      "mom_series",
      "mom_difficulty"
    ],
    "difficulty_values": {
      "0": "Beginner",
      "1": "Standard",
      "2": "Proud"
    },
    "legacy": "Rows without music_chest_placement_version retain their existing song-based or vanilla chest identity."
  },
  "coordinates": {
    "position": "Unreal world X/Y/Z in centimeters; final chest mesh position, not PopTracker map pixels.",
    "rotation": "Pitch/Yaw/Roll in degrees. Includes the agreed facing correction; do not add another 180 degrees.",
    "logic": "Each chest inherits access to its named world region; there are currently no additional per-spot traversal requirements."
  },
